# ──────────────────────────────────────────────
# Project Pulse — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in values:
#   cp .env.example .env.local
# ──────────────────────────────────────────────

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>/<database>"

# NextAuth.js session encryption secret
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="<generate-a-secure-secret>"

# NextAuth.js canonical URL (required for OAuth callback resolution)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Google OAuth 2.0 credentials
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="<google-client-id>"
GOOGLE_CLIENT_SECRET="<google-client-secret>"

# Development-only QA auth bypass.
# Only works when NODE_ENV=development and must never be enabled in production.
DEV_AUTH_BYPASS="false"

# RapidAPI keys for external data (e.g. ExerciseDB)
# Get at: https://rapidapi.com
# ⚠️ WARNING: RAPIDAPI_KEY is private and must NEVER be committed to version control.
RAPIDAPI_KEY="<rapidapi-key>"
# RAPIDAPI_HOST is the ExerciseDB host
RAPIDAPI_HOST=exercisedb.p.rapidapi.com

# USDA FoodData Central API Key
# Get at: https://fdc.nal.usda.gov/api-key-signup.html
# ⚠️ WARNING: USDA_API_KEY is private and must NEVER be committed to version control.
USDA_API_KEY="<usda-api-key>"
