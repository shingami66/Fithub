# ──────────────────────────────────────────────
# Project Pulse — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in values:
#   cp .env.example .env.local
# ──────────────────────────────────────────────

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=

# NextAuth.js session encryption secret
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# NextAuth.js canonical URL (required for OAuth callback resolution)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Google OAuth 2.0 credentials
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# RapidAPI key for external food/nutrition data
# Get at: https://rapidapi.com
RAPIDAPI_KEY=
